{
  "name": "openmail",
  "productName": "OpenMail",
  "version": "0.2.0",
  "description": "Open-source Outlook-style mail client that keeps your Gmail in standard PST files, with a native PST engine (no Outlook needed) and rules.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "OpenMail contributors",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "test:outlook": "node scripts/outlook-smoke.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "mailparser": "^3.7.1",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "pst-extractor": "^1.12.0"
  },
  "build": {
    "appId": "org.openmail.desktop",
    "productName": "OpenMail",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon-512.png"
    }
  }
}
